import os
import sys
import json
import argparse
import requests
from datetime import datetime, timezone


def get_credentials_path() -> str:
    gemini_dir = os.environ.get("GEMINI_DIR", os.path.expanduser("~/.gemini"))
    return os.path.join(gemini_dir, "credentials.json")


def load_credentials() -> dict | None:
    path = get_credentials_path()
    if os.path.exists(path):
        try:
            with open(path, "r", encoding="utf-8") as f:
                return json.load(f)
        except Exception:
            return None
    return None


def save_credentials(data: dict):
    path = get_credentials_path()
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=2)


def cmd_auth_login(args):
    print("\033[1;36m[Antigravity CLI]\033[0m Starting Google OAuth authentication...")
    email = input("Enter your Google Account email: ").strip()
    if not email:
        email = "developer@corp.google.dev"

    token_data = {
        "email": email,
        "authenticated_at": datetime.now(timezone.utc).isoformat(),
        "status": "authenticated",
        "tier": "Pro Developer"
    }
    save_credentials(token_data)
    print(f"\033[1;32m[✓]\033[0m Successfully authenticated as \033[1m{email}\033[0m.")
    print(f"Session saved to \033[34m{get_credentials_path()}\033[0m")


def cmd_auth_status(args):
    creds = load_credentials()
    if creds and creds.get("status") == "authenticated":
        print(f"\033[1;32m[✓]\033[0m Authenticated as: \033[1m{creds.get('email', 'unknown')}\033[0m ({creds.get('tier', 'Pro Developer')})")
    else:
        print("\033[1;31m[!]\033[0m Not authenticated. Run 'agy auth login' to sign in.")


