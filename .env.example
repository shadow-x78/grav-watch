# GravWatch Environment Configuration Template
# Copy to .env and adjust variables as needed

# Host Port Bindings
SERVER_PORT=8000

# Security Keys
AGENT_API_KEY=gravwatch-agent-secret-key
MASTER_API_KEY=gravwatch-master-secret-key

# Database URL (SQLite default, or asyncpg PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./data/gravwatch.db

# Agent Scraping Loop Settings
POLL_INTERVAL_SECONDS=300
USE_MOCK_FALLBACK=false
