FROM python:3.11-slim-bookworm

LABEL maintainer="shadow-x78 <https://github.com/shadow-x78/grav-watch>"
LABEL description="GravWatch isolated minimal container agent for Google Antigravity CLI"

ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    PATH="/usr/local/bin:/root/.local/bin:$PATH" \
    HOME=/tmp

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    procps \
    tar \
    gzip \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://antigravity.google/cli/install.sh | bash -s -- --dir /usr/local/bin

COPY services/agent/requirements.txt /app/services/agent/
RUN pip install --no-cache-dir -r /app/services/agent/requirements.txt

COPY services/ /app/services/
COPY packaging/docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

RUN mkdir -p /tmp/.gemini /tmp/.config/antigravity /tmp/.config/Code/User/globalStorage /tmp/.config/Antigravity/User/globalStorage
RUN ln -sf /tmp/.gemini /root/.gemini
RUN ln -sf /tmp/.config /root/.config

ENTRYPOINT ["/entrypoint.sh"]
