[TEMPLATE]
# ─────────────────────────────────────────────
# GravWatch - Environment Variables Template
# ─────────────────────────────────────────────

# ── Server Configuration ──

SERVER_PORT=8000
WEB_PORT=3000
PUBLIC_ORIGIN=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Database Configuration ──

DATABASE_URL=sqlite+aiosqlite:///./data/gravwatch.db

# ── Agent Settings ──

POLL_INTERVAL_SECONDS=30
HOST_ANTIGRAVITY_STATE_PATH=
