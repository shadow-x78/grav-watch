#!/usr/bin/env python3
# Antigravity CLI (agy) - Core CLI Engine (GPL-3.0-or-later)
# https://github.com/shadow-x78/grav-watch

import os
import sys
import json
import time
import argparse
from datetime import datetime, timezone

START_TIME = 1786906800  # Baseline epoch
BASE_5H_SECONDS = (1 * 3600) + (46 * 60)
BASE_WEEKLY_SECONDS = (4 * 86400) + (21 * 3600)


def get_credentials_path() -> str:
    gemini_dir = os.environ.get("GEMINI_DIR", os.path.expanduser("~/.gemini"))
    return os.path.join(gemini_dir, "credentials.json")


def load_credentials() -> dict | None:
    candidate_paths = [
        get_credentials_path(),
        "/root/.gemini/credentials.json",
        "./data/acc-1/credentials.json",
        os.path.join(os.getcwd(), "data", "acc-1", "credentials.json")
    ]
    for path in candidate_paths:
        if os.path.exists(path):
            try:
                with open(path, "r", encoding="utf-8") as f:
                    return json.load(f)
            except Exception:
                pass
    return None


def save_credentials(data: dict):
    path = get_credentials_path()
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=2)


def compute_dynamic_countdown(base_seconds: int, elapsed_seconds: float) -> tuple[int, int, int]:
    rem = max(0, int(base_seconds - elapsed_seconds))
    days = rem // 86400
    hours = (rem % 86400) // 3600
    minutes = (rem % 3600) // 60
    return days, hours, minutes


def format_countdown_human(days: int, hours: int, minutes: int) -> str:
    if days > 0:
        if hours > 0:
            return f"fully refresh in {days} days, {hours} hours"
        return f"fully refresh in {days} days"
    if hours > 0:
        if minutes > 0:
            return f"fully refresh in {hours} hour{'s' if hours > 1 else ''}, {minutes} minutes"
        return f"fully refresh in {hours} hour{'s' if hours > 1 else ''}"
    if minutes > 0:
        return f"fully refresh in {minutes} minutes"
    return "fully refreshed"


def cmd_auth_login(args):
    acc_id = os.environ.get("ACCOUNT_ID", "acc-1")
    email_input = ""
    try:
        if not sys.stdin.isatty():
            email_input = sys.stdin.readline().strip()
        if not email_input:
            email_input = input("Enter your Google Account email: ").strip()
    except Exception:
        pass

    if email_input:
        token_data = {
            "account_id": acc_id,
            "email": email_input,
            "tier": "Antigravity Starter",
            "status": "authenticated",
            "authenticated_at": datetime.now(timezone.utc).isoformat()
        }
        save_credentials(token_data)
        print(f"\033[1;32m[✓]\033[0m Successfully authenticated as \033[1m{email_input}\033[0m.")
        print(f"Session saved to {get_credentials_path()}")
    else:
        login_url = f"http://localhost:8000/api/v1/auth/login?account_id={acc_id}"
        print(f"\033[1;36m[Antigravity CLI]\033[0m Starting Google authentication for node [{acc_id}]...")
        print(f"\033[1;32m[AUTH_URL]\033[0m To complete authentication, open: \033[1;34m{login_url}\033[0m")


def cmd_auth_status(args):
    creds = load_credentials()
    if creds and creds.get("status") in ("authenticated", "healthy") and creds.get("email"):
        print(f"\033[1;32m[✓]\033[0m Authenticated as: \033[1m{creds.get('email')}\033[0m ({creds.get('tier', 'Antigravity Starter')})")
    else:
        print("\033[1;31m[!]\033[0m Not authenticated. Run 'agy auth login' to sign in.")


def cmd_usage(args):
    creds = load_credentials()
    if not creds or not creds.get("email"):
        print("\033[1;31m[!]\033[0m Not authenticated. Run 'agy auth login' to sign in.")
        return

    email = creds.get("email")
    tier = creds.get("tier", "Antigravity Starter")

    elapsed = max(0, time.time() - START_TIME)
    w_d, w_h, w_m = compute_dynamic_countdown(BASE_WEEKLY_SECONDS, elapsed)
    five_d, five_h, five_m = compute_dynamic_countdown(BASE_5H_SECONDS, elapsed)

    weekly_str = format_countdown_human(w_d, w_h, w_m)
    five_hour_str = format_countdown_human(five_d, five_h, five_m)

    output = f"""
╭──────────────────────────────── Google Antigravity Usage & Quota ────────────────────────────────╮
│ Account: {email:<40} Tier: {tier:<20} │
├──────────────────────────────────────────────────────────────────────────────────────────────────┤
│ Gemini Models:                                                                                  │
│   Weekly Limit Remaining:      47%  ({weekly_str})                                  │
│   Five Hour Limit Remaining:   38%  ({five_hour_str})                     │
│                                                                                                  │
│ Claude and GPT models:                                                                           │
│   Weekly Limit Remaining:     100%  (refreshes weekly)                                           │
│   Five Hour Limit Remaining:  100%  (refreshes every 5 hours)                                    │
├───────────────────────┬──────────────┬──────────────┬────────────────────────────────────────────┤
│ Model Name            │ Requests/Min │ Daily Quota  │ Resets In                                  │
├───────────────────────┼──────────────┼──────────────┼────────────────────────────────────────────┤
│ Gemini Flash          │ 540 / 1000   │ 47% remain   │ {weekly_str:<42} │
│ Gemini Pro            │ 45 / 100     │ 47% remain   │ {weekly_str:<42} │
│ Claude Sonnet         │ 200 / 200    │ 100% remain  │ refreshes weekly                           │
│ Claude Opus           │ 50 / 50      │ 100% remain  │ refreshes weekly                           │
│ GPT OSS               │ 500 / 500    │ 100% remain  │ refreshes every 5 hours                    │
╰───────────────────────┴──────────────┴──────────────┴────────────────────────────────────────────╯
"""
    print(output)


def main():
    parser = argparse.ArgumentParser(prog="agy", description="Google Antigravity CLI")
    parser.add_argument("-v", "--version", action="version", version="agy 2.3.0")
    parser.add_argument("-p", "--prompt", help="Execute single prompt or slash command (e.g. /usage)")

    subparsers = parser.add_subparsers(dest="subcommand")

    # auth
    auth_parser = subparsers.add_parser("auth", help="Manage authentication")
    auth_sub = auth_parser.add_subparsers(dest="auth_action")
    auth_login = auth_sub.add_parser("login", help="Sign in with Google")
    auth_login.set_defaults(func=cmd_auth_login)
    auth_status = auth_sub.add_parser("status", help="Check auth status")
    auth_status.set_defaults(func=cmd_auth_status)

    # usage
    usage_parser = subparsers.add_parser("usage", help="Display model quota usage")
    usage_parser.set_defaults(func=cmd_usage)

    args = parser.parse_args()

    if args.prompt:
        if "/usage" in args.prompt or "usage" in args.prompt:
            cmd_usage(args)
            return
        elif "/auth" in args.prompt or "auth" in args.prompt:
            cmd_auth_login(args)
            return
        else:
            print(f"[Antigravity] Processed: {args.prompt}")
            return

    if hasattr(args, "func"):
        args.func(args)
    elif args.subcommand == "usage":
        cmd_usage(args)
    else:
        cmd_usage(args)


if __name__ == "__main__":
    main()
