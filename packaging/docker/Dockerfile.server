FROM python:3.11-slim-bookworm

LABEL maintainer="shadow-x78 <https://github.com/shadow-x78/grav-watch>"
LABEL description="GravWatch central FastAPI server and database"

ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY services/server/requirements.txt /app/services/server/
RUN pip install --no-cache-dir -r /app/services/server/requirements.txt

COPY services/ /app/services/

EXPOSE 8000

CMD ["uvicorn", "services.server.main:app", "--host", "0.0.0.0", "--port", "8000"]
