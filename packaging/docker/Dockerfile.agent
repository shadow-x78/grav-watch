FROM python:3.11-slim-bookworm

LABEL maintainer="shadow-x78 <https://github.com/shadow-x78/grav-watch>"
LABEL description="GravWatch isolated minimal container agent for Google Antigravity CLI"

ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    procps \
    && rm -rf /var/lib/apt/lists/*

COPY services/agent/requirements.txt /app/services/agent/
RUN pip install --no-cache-dir -r /app/services/agent/requirements.txt

COPY services/ /app/services/
COPY packaging/docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
