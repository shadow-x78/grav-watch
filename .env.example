# GravWatch Environment Configuration Template
# Copy to .env and adjust variables as needed

# Host Port Bindings
SERVER_PORT=8000
WEB_PORT=3000

# Security Keys (Generate strong 32-byte keys for production)
AGENT_API_KEY=gravwatch-agent-secret-key
MASTER_API_KEY=gravwatch-master-secret-key

# Public URL (for browser redirects and CORS)
PUBLIC_ORIGIN=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Database URL (SQLite default, or asyncpg PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./data/gravwatch.db

# Agent Scraping & Pairing Settings
POLL_INTERVAL_SECONDS=300
HOST_ANTIGRAVITY_STATE_PATH=
