# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*~

# IDE & Editor Files
.idea/
.vscode/
*.swp
*.swo
*.iml
.project
.classpath
.settings/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
/lib/
/lib64/
!clients/web/src/lib/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Local Database & Container Volumes
*.db
*.sqlite
*.sqlite3
data/acc-*/
data/acc-*-agent/
data/server/
gravwatch.db

# Environment & Secret Files
.env
.env.local
.env.*.local
docker/.env
!docker/.env.example

# Web Client (Node / Next.js)
clients/web/node_modules/
clients/web/.next/
clients/web/.env.local
clients/web/.env.*.local
clients/web/tsconfig.tsbuildinfo
clients/web/out/
clients/web/build/

