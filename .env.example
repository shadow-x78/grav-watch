# ==============================================================================
# GravWatch Environment Configuration
# ==============================================================================

# Shared Authentication Key between Agents and FastAPI Server
AGENT_API_KEY=gravwatch-agent-secret-key

# Master Key for Administrative/Diagnostic Operations
MASTER_API_KEY=gravwatch-master-secret-key

# Database Connection URL (Async SQLite or PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./data/gravwatch.db

# Discord Webhook URL for Quota Threshold Alerts (Leave empty to disable)
DISCORD_WEBHOOK_URL=

# Quota Utilization Threshold Percentage to Trigger Alerts (0-100)
ALERT_THRESHOLD_PERCENT=85.0

# Polling Interval in Seconds for Agent Containers
POLL_INTERVAL_SECONDS=300

# Enable Synthetic Mock Telemetry When CLI Authentication is Unavailable
USE_MOCK_FALLBACK=true
